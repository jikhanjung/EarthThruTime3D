# Example only: Django does not automatically load this file.
# For local development no environment file is required.
# Export these variables before using production settings.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=
ALLOWED_HOSTS=localhost
DATABASE_PATH=/srv/earththrutime3d/db/db.sqlite3
MEDIA_ROOT=/srv/earththrutime3d/media
STATIC_ROOT=/srv/earththrutime3d/static
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
