# Copy to .env.django, chmod 600, and replace the secret before the first deploy.
SECRET_KEY=replace-with-at-least-50-random-characters
ALLOWED_HOSTS=127.0.0.1,localhost,earththrutime.nopeoplestime.info
CSRF_TRUSTED_ORIGINS=https://earththrutime.nopeoplestime.info
TRUST_PROXY_HEADERS=true
# The host proxy terminates TLS and already redirects, so the app must not redirect too.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=86400
# One shared key standing in for accounts. Empty leaves the site open; set it and every
# page asks once, and models whose licence forbids publication become available because
# the site is then closed. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(24))'
ACCESS_KEY=
# The viewer is on; the published PALEOMAP images are not served. See deploy.toml.
SCOTESE_VIEWER_ENABLED=true
SCOTESE_SOURCE_MAPS_PUBLIC=false
SCOTESE_VIEWER_STEPS=4
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
